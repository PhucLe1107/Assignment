@{
}
<ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
    <!-- Sidebar - Brand -->
    <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/">
        <div class="sidebar-brand-icon rotate-n-15">
            <i class="fas fa-graduation-cap"></i>
        </div>
        <div class="sidebar-brand-text mx-3">@L["Trung tâm Anh ngữ"]</div>
    </a>

    <!-- Divider -->
    <hr class="sidebar-divider my-0">

    <!-- Nav Item - Dashboard -->
    <li class="nav-item">
        <a class="nav-link" href="/">
            <i class="fas fa-fw fa-tachometer-alt"></i>
            <span>@L["Bảng điều khiển"]</span>
        </a>
    </li>

    <!-- Nav Item - Class -->
    <li class="nav-item">
        <a class="nav-link" href="/Class/Index">
            <i class="fas fa-fw fa-users"></i>
            <span>@L["Lớp học"]</span>
        </a>
    </li>

    <!-- Nav Item - Enrollment -->
    <li class="nav-item">
        <a class="nav-link" href="/Enrollment/Index">
            <i class="fas fa-fw fa-user-check"></i>
            <span>@L["Ghi danh"]</span>
        </a>
    </li>

    <!-- Nav Item - Course -->
    <li class="nav-item">
        <a class="nav-link" href="/Course/Index">
            <i class="fas fa-fw fa-book-open"></i>
            <span>@L["Khóa học"]</span>
        </a>
    </li>

    <!-- Nav Item - Attendance -->
    <li class="nav-item">
        <a class="nav-link" asp-controller="Attendance" asp-action="Index">
            <i class="fas fa-fw fa-calendar-check"></i>
            <span>@L["Điểm danh"]</span>
        </a>
    </li>

    <!-- Nav Item - Grade -->
    <li class="nav-item">
        <a class="nav-link" asp-controller="Grade" asp-action="Index">
            <i class="fas fa-fw fa-chart-bar"></i>
            <span>@L["Điểm số"]</span>
        </a>
    </li>

</ul>
