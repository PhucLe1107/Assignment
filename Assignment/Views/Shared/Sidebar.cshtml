@{
}
<ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
    <!-- Sidebar - Brand -->
    <a class="sidebar-brand d-flex align-items-center justify-content-center" href="/">
        <div class="sidebar-brand-icon rotate-n-15">
            <i class="fas fa-graduation-cap"></i>
        </div>
        <div class="sidebar-brand-text mx-3">SB Admin <sup>2</sup></div>
    </a>

    <!-- Divider -->
    <hr class="sidebar-divider my-0">

    @if (User.IsInRole("SinhVien"))
    {
        <!-- Menu dành riêng cho Học viên -->
        <li class="nav-item">
            <a class="nav-link" asp-controller="StudentPortal" asp-action="MyLearning">
                <i class="fas fa-fw fa-book-reader"></i>
                <span>Khóa học của tôi</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="StudentPortal" asp-action="MyAttendance">
                <i class="fas fa-fw fa-calendar-check"></i>
                <span>Kết quả điểm danh</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="StudentPortal" asp-action="MyGrades">
                <i class="fas fa-fw fa-clipboard-list"></i>
                <span>Bảng điểm cá nhân</span>
            </a>
        </li>
    }
    else if (User.IsInRole("Admin") || User.IsInRole("GiaoVu"))
    {
        <!-- Menu quản lý dành cho Admin và Giáo vụ -->
        <li class="nav-item">
            <a class="nav-link" asp-controller="Course" asp-action="Index">
                <i class="fas fa-fw fa-book-open"></i>
                <span>Khóa học</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Class" asp-action="Index">
                <i class="fas fa-fw fa-chalkboard-teacher"></i>
                <span>Lớp học</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Student" asp-action="Index">
                <i class="fas fa-fw fa-user-graduate"></i>
                <span>Học viên</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Enrollment" asp-action="Index">
                <i class="fas fa-fw fa-user-check"></i>
                <span>Ghi danh</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Attendance" asp-action="Index">
                <i class="fas fa-fw fa-calendar-alt"></i>
                <span>Điểm danh</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Grade" asp-action="Index">
                <i class="fas fa-fw fa-award"></i>
                <span>Sổ điểm</span>
            </a>
        </li>
    }

</ul>