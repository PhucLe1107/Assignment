@model Assignment.Models.Entities.Enrollment

@{
    ViewData["Title"] = L["Hủy Ghi danh Lớp học"];
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-danger">@L["Hủy Ghi danh Lớp học"]</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> @L["Quay lại"]
        </a>
    </div>

    <div class="card shadow mb-4 col-lg-6 mx-auto border-left-danger p-0">
        <div class="card-header py-3 bg-danger text-white">
            <h6 class="m-0 font-weight-bold">@L["Cảnh báo hủy hồ sơ ghi danh"]</h6>
        </div>
        <div class="card-body">
            <div class="text-center mb-3">
                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-2"></i>
                <h5 class="text-gray-900 font-weight-bold">@L["Bạn có chắc muốn rút học viên khỏi lớp này?"]</h5>
                <p class="text-muted small">@L["Hệ thống chỉ cho phép hủy nếu học viên chưa có lịch sử điểm danh và chưa vào bảng điểm."]</p>
            </div>

            <div class="bg-light p-3 rounded mb-3">
                <div class="row mb-2">
                    <div class="col-sm-4 font-weight-bold">@L["Học viên"]:</div>
                    <div class="col-sm-8 text-primary font-weight-bold">@Model.Student?.FullName (@Model.Student?.StudentCode)</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 font-weight-bold">@L["Lớp học"]:</div>
                    <div class="col-sm-8">@Model.Class?.ClassCode - @Model.Class?.ClassName</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 font-weight-bold">@L["Học phí thực tế"]:</div>
                    <div class="col-sm-8">@Model.ActualFee.ToString("N0") @L["VNĐ"]</div>
                </div>
                <div class="row">
                    <div class="col-sm-4 font-weight-bold">@L["Đã nộp"]:</div>
                    <div class="col-sm-8 text-success font-weight-bold">@Model.PaidAmount.ToString("N0") @L["VNĐ"]</div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EnrollmentId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary shadow-sm">@L["Hủy bỏ"]</a>
                    <button type="submit" class="btn btn-danger shadow-sm">
                        <i class="fas fa-trash mr-1"></i> @L["Xác nhận xóa"]
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
