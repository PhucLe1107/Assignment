    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Assignment.Models.Entities.Enrollment

@{
    ViewData["Title"] = L["Cập nhật Ghi danh"];
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@L["Cập nhật thông tin Ghi danh"]</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> @L["Quay lại"]
        </a>
    </div>

    <div class="card shadow mb-4 p-0 border-left-warning">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-warning">@L["Mã ghi danh"]: #@Model.EnrollmentId</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EnrollmentId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="StudentId" class="font-weight-bold">@L["Học viên"] <span class="text-danger">*</span></label>
                        <select asp-for="StudentId" class="form-control" asp-items="ViewBag.StudentId"></select>
                        <span asp-validation-for="StudentId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="ClassId" class="font-weight-bold">@L["Lớp học"] <span class="text-danger">*</span></label>
                        <select asp-for="ClassId" id="classSelect" class="form-control" asp-items="ViewBag.ClassId"></select>
                        <span asp-validation-for="ClassId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="ActualFee" class="font-weight-bold">@L["Học phí thực tế (VNĐ)"] <span class="text-danger">*</span></label>
                        <input asp-for="ActualFee" id="actualFeeInput" type="number" class="form-control" />
                        <span asp-validation-for="ActualFee" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="PaidAmount" class="font-weight-bold">@L["Số tiền đã nộp (VNĐ)"] <span class="text-danger">*</span></label>
                        <input asp-for="PaidAmount" type="number" class="form-control" />
                        <span asp-validation-for="PaidAmount" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="EnrollmentDate" class="font-weight-bold">@L["Ngày đăng ký"]</label>
                        <input asp-for="EnrollmentDate" type="date" class="form-control" value="@Model.EnrollmentDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="EnrollmentDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="LearningStatus" class="font-weight-bold">@L["Trạng thái học"]</label>
                        <select asp-for="LearningStatus" class="form-control">
                            <option value="DangHoc">@L["Đang học"]</option>
                            <option value="HoanThanh">@L["Hoàn thành khóa học"]</option>
                            <option value="BaoLuu">@L["Bảo lưu"]</option>
                            <option value="NghiHoc">@L["Nghỉ học"]</option>
                        </select>
                        <span asp-validation-for="LearningStatus" class="text-danger small"></span>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary shadow-sm">@L["Hủy bỏ"]</a>
                    <button type="submit" class="btn btn-warning shadow-sm">
                        <i class="fas fa-check mr-1"></i> @L["Lưu thay đổi"]
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Tự động lấy học phí chuẩn của khóa học khi đổi lớp học
        $('#classSelect').on('change', function () {
            var selectedClassId = $(this).val();

            if (!selectedClassId) {
                $('#actualFeeInput').val('');
                return;
            }

            $.ajax({
                url: '/api/classes/' + encodeURIComponent(selectedClassId) + '/fee',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    if (data && data.fee !== undefined) {
                        $('#actualFeeInput').val(data.fee);
                    }
                },
                error: function (xhr) {
                    $('#actualFeeInput').val('');
                    if (xhr.status === 404) {
                        console.warn(xhr.responseJSON?.message || 'Không tìm thấy lớp học.');
                    } else {
                        console.error('Lỗi khi tải học phí:', xhr.responseJSON?.message || xhr.statusText);
                    }
                }
            });
        });
    </script>
}
