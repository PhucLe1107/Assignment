@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Assignment.Models.GradeSheetViewModel

@{
    ViewData["Title"] = L["Nhập điểm Lớp học"];
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@L["Nhập điểm Lớp học"]</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-list fa-sm text-white-50 mr-1"></i> @L["Sổ điểm tổng hợp"]
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Form Chọn lớp & kỳ thi -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">@L["Chọn Lớp học và Kỳ kiểm tra"]</h6>
        </div>
        <div class="card-body">
            <form asp-action="EnterGrades" method="get">
                <div class="form-row align-items-end">
                    <div class="col-md-6 mb-2">
                        <label class="font-weight-bold">@L["Lớp học"]:</label>
                        <select name="classId" asp-items="ViewBag.ClassId" class="form-control form-control-sm" required>
                            <option value="">-- @L["Chọn lớp học"] --</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="font-weight-bold">@L["Kỳ kiểm tra"]:</label>
                        <select name="examType" class="form-control form-control-sm">
                            <option value="GiuaKy" selected="@(Model.ExamType == "GiuaKy")">@L["Kiểm tra giữa kỳ (Mid-term)"]</option>
                            <option value="CuoiKy" selected="@(Model.ExamType == "CuoiKy")">@L["Thi cuối khóa (Final Exam)"]</option>
                            <option value="PlacementTest" selected="@(Model.ExamType == "PlacementTest")">@L["Kiểm tra đầu vào (Placement)"]</option>
                            <option value="ProgressTest1" selected="@(Model.ExamType == "ProgressTest1")">@L["Test tiến độ 1"]</option>
                            <option value="ProgressTest2" selected="@(Model.ExamType == "ProgressTest2")">@L["Test tiến độ 2"]</option>
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <button type="submit" class="btn btn-primary btn-sm btn-block">
                            <i class="fas fa-table fa-sm mr-1"></i> @L["Tải bảng điểm"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng nhập điểm học viên -->
    @if (Model.ClassId > 0)
    {
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    @L["Bảng điểm"]: <span class="text-dark">@Model.ClassName (@Model.ClassCode)</span>
                    @if (!string.IsNullOrEmpty(Model.CourseName))
                    {
                        <span class="badge badge-info ml-1">@Model.CourseName</span>
                    }
                    - @L["Kỳ"]: <span class="badge badge-warning text-dark font-weight-bold">@Model.ExamType</span>
                </h6>
            </div>
            <div class="card-body">
                @if (Model.Students != null && Model.Students.Any())
                {
                    <form asp-action="SaveGrades" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ClassId" />
                        <input type="hidden" asp-for="ClassName" />
                        <input type="hidden" asp-for="ClassCode" />
                        <input type="hidden" asp-for="CourseName" />
                        <input type="hidden" asp-for="ExamType" />

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                                <thead class="thead-light text-center">
                                    <tr>
                                        <th style="width: 50px;">@L["STT"]</th>
                                        <th style="width: 120px;">@L["Mã HV"]</th>
                                        <th class="text-left">@L["Họ và tên"]</th>
                                        <th style="width: 105px;">@L["Nghe (L)"]</th>
                                        <th style="width: 105px;">@L["Đọc (R)"]</th>
                                        <th style="width: 105px;">@L["Viết (W)"]</th>
                                        <th style="width: 105px;">@L["Nói (S)"]</th>
                                        <th style="width: 90px;">Overall</th>
                                        <th>@L["Nhận xét của giáo viên"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Students.Count; i++)
                                    {
                                        <tr>
                                            <td class="text-center align-middle font-weight-bold">@(i + 1)</td>
                                            <td class="align-middle">
                                                <strong>@Model.Students[i].StudentCode</strong>
                                                <input type="hidden" asp-for="@Model.Students[i].EnrollmentId" />
                                                <input type="hidden" asp-for="@Model.Students[i].GradeId" />
                                                <input type="hidden" asp-for="@Model.Students[i].StudentCode" />
                                                <input type="hidden" asp-for="@Model.Students[i].FullName" />
                                            </td>
                                            <td class="align-middle font-weight-bold text-gray-800">
                                                @Model.Students[i].FullName
                                            </td>
                                            <td>
                                                <input asp-for="@Model.Students[i].ListeningScore" type="number" step="any" min="0" max="990" 
                                                       class="form-control form-control-sm text-center score-input" placeholder="-" />
                                            </td>
                                            <td>
                                                <input asp-for="@Model.Students[i].ReadingScore" type="number" step="any" min="0" max="990" 
                                                       class="form-control form-control-sm text-center score-input" placeholder="-" />
                                            </td>
                                            <td>
                                                <input asp-for="@Model.Students[i].WritingScore" type="number" step="any" min="0" max="990" 
                                                       class="form-control form-control-sm text-center score-input" placeholder="-" />
                                            </td>
                                            <td>
                                                <input asp-for="@Model.Students[i].SpeakingScore" type="number" step="any" min="0" max="990" 
                                                       class="form-control form-control-sm text-center score-input" placeholder="-" />
                                            </td>
                                            <td class="text-center align-middle font-weight-bold text-primary overall-score">
                                                @(Model.Students[i].OverallScore?.ToString() ?? "-")
                                            </td>
                                            <td>
                                                <input asp-for="@Model.Students[i].TeacherFeedback" class="form-control form-control-sm" placeholder="@L["Nhận xét tiến bộ..."]" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-primary shadow-sm px-4">
                                <i class="fas fa-save mr-1"></i> @L["Lưu toàn bộ bảng điểm"]
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-user-slash fa-3x mb-2 text-gray-300"></i>
                        <p>@L["Lớp học này hiện chưa có học viên nào đang theo học."]</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Tính toán hiển thị nhanh Overall Score trên trình duyệt
        $(document).on('input', '.score-input', function () {
            var row = $(this).closest('tr');
            var scores = [];

            row.find('.score-input').each(function () {
                var val = parseFloat($(this).val());
                if (!isNaN(val) && val >= 0) {
                    scores.push(val);
                }
            });

            if (scores.length > 0) {
                var courseText = '@Model.CourseName'.toUpperCase();
                var examText = '@Model.ExamType'.toUpperCase();

                if (courseText.indexOf('TOEIC') !== -1 || examText.indexOf('TOEIC') !== -1) {
                    // TOEIC: Cộng điểm
                    var total = scores.reduce((a, b) => a + b, 0);
                    row.find('.overall-score').text(total);
                } else {
                    // IELTS / Thang 10: Trung bình cộng
                    var avg = (scores.reduce((a, b) => a + b, 0) / scores.length).toFixed(1);
                    row.find('.overall-score').text(avg);
                }
            } else {
                row.find('.overall-score').text('-');
            }
        });
    </script>
}
