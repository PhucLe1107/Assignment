@model Assignment.Models.Entities.User

@{
    ViewData["Title"] = "Xóa Tài khoản";
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-danger">Xóa Tài khoản Người dùng</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Quay lại
        </a>
    </div>

    <div class="card shadow mb-4 col-lg-6 mx-auto p-0 border-left-danger">
        <div class="card-header py-3 bg-danger text-white">
            <h6 class="m-0 font-weight-bold">Cảnh báo xóa tài khoản</h6>
        </div>
        <div class="card-body">
            <div class="text-center mb-3">
                <i class="fas fa-user-slash fa-3x text-danger mb-2"></i>
                <h5 class="text-gray-900 font-weight-bold">Bạn có chắc muốn xóa tài khoản này?</h5>
                <p class="text-muted small">Nếu tài khoản này đang gắn với một học viên, việc xóa sẽ bị chặn để bảo vệ dữ liệu đào tạo.</p>
            </div>

            <div class="bg-light p-3 rounded mb-3">
                <div class="row mb-2">
                    <div class="col-sm-5 font-weight-bold">Tên đăng nhập:</div>
                    <div class="col-sm-7 text-primary font-weight-bold">@Model.Username</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-5 font-weight-bold">Vai trò:</div>
                    <div class="col-sm-7 font-weight-bold">@Model.Role?.RoleName</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-5 font-weight-bold">Đối tượng liên kết:</div>
                    <div class="col-sm-7">
                        @(Model.Student != null ? $"{Model.Student.FullName} ({Model.Student.StudentCode})" : "Không liên kết học viên")
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-5 font-weight-bold">Trạng thái:</div>
                    <div class="col-sm-7">
                        @(Model.IsActive ? "Đang hoạt động" : "Đã khóa")
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary shadow-sm">Hủy bỏ</a>
                    <button type="submit" class="btn btn-danger shadow-sm">
                        <i class="fas fa-trash mr-1"></i> Xác nhận xóa
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
