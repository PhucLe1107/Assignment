    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Assignment.Models.UserEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa Tài khoản";
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Cập nhật Tài khoản</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Quay lại
        </a>
    </div>

    <div class="card shadow mb-4 mx-auto p-0 border-left-warning">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-warning">Tài khoản: @Model.Username</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Username" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="form-group">
                    <label class="font-weight-bold">Tên đăng nhập:</label>
                    <input class="form-control" value="@Model.Username" disabled />
                </div>

                <div class="form-group">
                    <label asp-for="RoleId" class="font-weight-bold">Vai trò hệ thống <span class="text-danger">*</span></label>
                    <select asp-for="RoleId" asp-items="ViewBag.RoleId" class="form-control" id="roleSelect"></select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>

                <div class="form-group" id="studentLinkGroup" style="display: none;">
                    <div class="card bg-light border-left-info p-3">
                        <label class="font-weight-bold text-gray-800">
                            <i class="fas fa-user-graduate text-info mr-1"></i> Hồ sơ Học viên liên kết
                        </label>
                        @if (!string.IsNullOrEmpty(Model.LinkedStudentName))
                        {
                            <div class="alert alert-info py-2 mb-2">
                                Đang gắn với: <strong>@Model.LinkedStudentName</strong> (Mã: @Model.LinkedStudentCode)
                            </div>
                        }
                        <select asp-for="StudentId" asp-items="ViewBag.UnlinkedStudents" class="form-control" id="studentSelect">
                            <option value="">-- Đổi sang học viên khác (nếu cần) --</option>
                        </select>
                        <span asp-validation-for="StudentId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword" class="font-weight-bold">Mật khẩu mới</label>
                    <input asp-for="NewPassword" class="form-control" placeholder="Để trống nếu không muốn đổi mật khẩu" />
                    <small class="text-muted">Chỉ nhập khi bạn muốn thiết lập lại mật khẩu mới cho người dùng này.</small>
                    <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
                </div>

                <div class="form-group">
                    <div class="custom-control custom-checkbox">
                        <input asp-for="IsActive" class="custom-control-input" id="isActiveCheck" />
                        <label class="custom-control-label font-weight-bold" for="isActiveCheck">Tài khoản đang hoạt động</label>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary shadow-sm">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning shadow-sm">
                        <i class="fas fa-check mr-1"></i> Lưu cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function checkRole() {
            var selectedText = $('#roleSelect option:selected').text().trim();
            if (selectedText === 'SinhVien') {
                $('#studentLinkGroup').slideDown(200);
            } else {
                $('#studentLinkGroup').slideUp(200);
            }
        }

        checkRole();
        $('#roleSelect').on('change', checkRole);
    </script>
}
