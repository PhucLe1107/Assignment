@model Assignment.Models.Entities.Student?

@{
    ViewData["Title"] = L["Bảng điểm cá nhân"];
    var enrollments = Model?.Enrollments?
        .OrderByDescending(e => e.EnrollmentDate)
        .ToList() ?? new List<Assignment.Models.Entities.Enrollment>();
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@L["Bảng điểm cá nhân"]</h1>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle mr-1"></i> @L["Tài khoản chưa được liên kết với hồ sơ học viên"]
        </div>
    }
    else if (!enrollments.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle mr-1"></i> @L["Bạn chưa đăng ký lớp học nào"]
        </div>
    }
    else
    {
        @foreach (var item in enrollments)
        {
            var grades = item.Grades?.OrderBy(g => g.GradeId).ToList() ?? new List<Assignment.Models.Entities.Grade>();

            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">
                        @item.Class?.Course?.CourseName
                        <small class="text-muted ml-1">(@item.Class?.ClassCode - @item.Class?.ClassName)</small>
                    </h6>
                    <span class="badge badge-info px-2 py-1">@L[DisplayLabels.LearningStatus(item.LearningStatus)]</span>
                </div>
                <div class="card-body">
                    @if (!grades.Any())
                    {
                        <div class="alert alert-light border small text-muted mb-0">
                            <i class="fas fa-info-circle mr-1"></i> @L["Chưa có cột điểm nào"]
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-0">
                                <thead class="thead-light text-center">
                                    <tr>
                                        <th>@L["Kỳ thi"]</th>
                                        <th style="width: 75px;">@L["Nghe (L)"]</th>
                                        <th style="width: 75px;">@L["Đọc (R)"]</th>
                                        <th style="width: 75px;">@L["Viết (W)"]</th>
                                        <th style="width: 75px;">@L["Nói (S)"]</th>
                                        <th style="width: 85px;">Overall</th>
                                        <th class="text-left">@L["Nhận xét"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var g in grades)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <span class="badge badge-light border">@L[DisplayLabels.ExamType(g.ExamType)]</span>
                                            </td>
                                            <td class="text-center">@(g.ListeningScore?.ToString() ?? "-")</td>
                                            <td class="text-center">@(g.ReadingScore?.ToString() ?? "-")</td>
                                            <td class="text-center">@(g.WritingScore?.ToString() ?? "-")</td>
                                            <td class="text-center">@(g.SpeakingScore?.ToString() ?? "-")</td>
                                            <td class="text-center font-weight-bold text-primary">@(g.OverallScore?.ToString() ?? "-")</td>
                                            <td>@g.TeacherFeedback</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }

</div>
