@model Assignment.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/LoginLayout.cshtml";
    ViewData["Title"] = L["Đăng nhập"];
}

<div class="row justify-content-center">
    <div class="col-xl-10 col-lg-12 col-md-9">
        <div class="card o-hidden border-0 shadow-lg my-5">
            <div class="card-body p-0">
                <!-- Nested Row within Card Body -->
                <div class="row">
                    <div class="col-lg-6 d-none d-lg-block bg-login-image"></div>
                    <div class="col-lg-6">
                        <div class="p-5">
                            <div class="text-center">
                                <h1 class="h4 text-gray-900 mb-4">@L["Chào mừng trở lại!"]</h1>
                            </div>

                            <form class="user" asp-action="Login" asp-controller="Account" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" asp-for="ReturnUrl" />

                                <div asp-validation-summary="ModelOnly" class="text-danger small text-center mb-3"></div>

                                <div class="form-group">
                                    <input type="text" class="form-control form-control-user"
                                           id="exampleInputEmail"
                                           placeholder="@L["Tên đăng nhập..."]" asp-for="Username">
                                    <span asp-validation-for="Username" class="text-danger small pl-3"></span>
                                </div>

                                <div class="form-group">
                                    <input type="password" class="form-control form-control-user"
                                           id="exampleInputPassword" placeholder="@L["Mật khẩu"]" asp-for="Password">
                                    <span asp-validation-for="Password" class="text-danger small pl-3"></span>
                                </div>

                                <div class="form-group">
                                    <div class="custom-control custom-checkbox small">
                                        <input type="checkbox" class="custom-control-input" id="customCheck" asp-for="RememberMe">
                                        <label class="custom-control-label" for="customCheck">
                                            @L["Ghi nhớ đăng nhập"]
                                        </label>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary btn-user btn-block">
                                    @L["Đăng nhập"]
                                </button>
                            </form>

                            <hr>
                            <div class="text-center">
                                <a class="small" href="#">@L["Quên mật khẩu?"]</a>
                            </div>
                            <div class="text-center">
                                <a class="small" href="#">@L["Tạo tài khoản!"]</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
