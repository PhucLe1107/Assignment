@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Assignment.Models.Common.PagedList<Assignment.Models.Entities.Class>

@{
    ViewData["Title"] = L["Quản lý Lớp học"];
    var pageIndex = Model?.PageIndex ?? 1;
    var totalPages = Math.Max(Model?.TotalPages ?? 0, 1);
    var totalItems = Model?.TotalItems ?? 0;
}

<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@L["Quản lý Lớp học"]</h1>
        <a asp-controller="Class" asp-action="Create" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> @L["Mở lớp học mới"]
        </a>
    </div>

    <!-- Thông báo kết quả -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Card danh sách -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">@L["Danh sách Lớp học"]</h6>
        </div>
        <div class="card-body">

            <!-- Thanh tìm kiếm & lọc khóa học -->
            <div class="row mb-3">
                <div class="col-sm-12 col-md-8">
                    <form asp-controller="Class" asp-action="Index" method="get">
                        <div class="form-row">
                            <div class="col-md-5 mb-2">
                                <input type="text" name="search" class="form-control form-control-sm" 
                                       placeholder="@L["Tìm theo mã lớp, tên lớp, giảng viên..."]" value="@ViewData["CurrentFilter"]" />
                            </div>
                            <div class="col-md-4 mb-2">
                                <select name="courseId" asp-items="ViewBag.CourseList" class="form-control form-control-sm">
                                    <option value="">-- @L["Tất cả khóa học"] --</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-2">
                                <button class="btn btn-primary btn-sm" type="submit">
                                    <i class="fas fa-search fa-sm"></i> @L["Lọc"]
                                </button>
                                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string) || ViewData["CurrentCourseId"] != null)
                                {
                                    <a asp-controller="Class" asp-action="Index" class="btn btn-secondary btn-sm">@L["Xóa lọc"]</a>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Table Data -->
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>@L["Mã lớp"]</th>
                            <th>@L["Tên lớp"]</th>
                            <th>@L["Khóa học"]</th>
                            <th>@L["Giảng viên"]</th>
                            <th>@L["Lịch học / Phòng"]</th>
                            <th>@L["Khai giảng"]</th>
                            <th>@L["Sĩ số"]</th>
                            <th class="text-center" style="width: 170px;">@L["Thao tác"]</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>@L["Mã lớp"]</th>
                            <th>@L["Tên lớp"]</th>
                            <th>@L["Khóa học"]</th>
                            <th>@L["Giảng viên"]</th>
                            <th>@L["Lịch học / Phòng"]</th>
                            <th>@L["Khai giảng"]</th>
                            <th>@L["Sĩ số"]</th>
                            <th class="text-center">@L["Thao tác"]</th>
                        </tr>
                    </tfoot>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                int currentEnrollment = item.Enrollments?.Count ?? 0;
                                <tr>
                                    <td class="align-middle"><strong>@item.ClassCode</strong></td>
                                    <td class="align-middle">@item.ClassName</td>
                                    <td class="align-middle"><span class="badge badge-light border">@item.Course?.CourseName</span></td>
                                    <td class="align-middle">@(string.IsNullOrEmpty(item.LecturerName) ? L["Chưa xếp GV"].Value : item.LecturerName)</td>
                                    <td class="align-middle small">
                                        <div><i class="fas fa-clock text-gray-500 mr-1"></i>@item.Schedule</div>
                                        <div><i class="fas fa-door-open text-gray-500 mr-1"></i>@(string.IsNullOrEmpty(item.Room) ? L["Chưa xếp phòng"].Value : item.Room)</div>
                                    </td>
                                    <td class="align-middle">@item.StartDate.ToString("d")</td>
                                    <td class="align-middle text-center">
                                        <span class="badge @(currentEnrollment >= item.MaxCapacity ? "badge-danger" : "badge-success")">
                                            @currentEnrollment / @item.MaxCapacity
                                        </span>
                                    </td>
                                    <td class="text-center align-middle">
                                        <a asp-action="Details" asp-route-id="@item.ClassId" class="btn btn-info btn-circle btn-sm" title="@L["Xem chi tiết"]">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ClassId" class="btn btn-warning btn-circle btn-sm" title="@L["Chỉnh sửa"]">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ClassId" class="btn btn-danger btn-circle btn-sm" title="@L["Xóa"]">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-3">@L["Không có lớp học nào phù hợp."]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang SB Admin 2 -->
            <div class="row mt-3">
                <div class="col-sm-12 col-md-5">
                    <div class="dataTables_info text-muted small" role="status" aria-live="polite">
                        @L["Hiển thị trang {0} / {1} (Tổng: {2} lớp)", pageIndex, totalPages, totalItems]
                    </div>
                </div>
                <div class="col-sm-12 col-md-7">
                    <div class="dataTables_paginate paging_simple_numbers d-flex justify-content-md-end">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="paginate_button page-item previous @(Model != null && !Model.HasPreviousPage ? "disabled" : "")">
                                <a asp-action="Index" 
                                   asp-route-page="@((Model?.PageIndex ?? 1) - 1)" 
                                   asp-route-search="@ViewData["CurrentFilter"]" 
                                   asp-route-courseId="@ViewData["CurrentCourseId"]"
                                   class="page-link">@L["Trước"]</a>
                            </li>

                            @for (int i = 1; i <= (Model?.TotalPages ?? 1); i++)
                            {
                                <li class="paginate_button page-item @(i == Model?.PageIndex ? "active" : "")">
                                    <a asp-action="Index" 
                                       asp-route-page="@i" 
                                       asp-route-search="@ViewData["CurrentFilter"]" 
                                       asp-route-courseId="@ViewData["CurrentCourseId"]"
                                       class="page-link">@i</a>
                                </li>
                            }

                            <li class="paginate_button page-item next @(Model != null && !Model.HasNextPage ? "disabled" : "")">
                                <a asp-action="Index" 
                                   asp-route-page="@((Model?.PageIndex ?? 1) + 1)" 
                                   asp-route-search="@ViewData["CurrentFilter"]" 
                                   asp-route-courseId="@ViewData["CurrentCourseId"]"
                                   class="page-link">@L["Sau"]</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
