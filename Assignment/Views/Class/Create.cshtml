    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Assignment.Models.Entities.Class

@{
    ViewData["Title"] = L["Mở lớp học mới"];
}

<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@L["Mở lớp học mới"]</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> @L["Quay lại danh sách"]
        </a>
    </div>

    <div class="card shadow mb-4 p-0">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">@L["Thông tin lớp học"]</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="ClassCode" class="font-weight-bold">@L["Mã lớp"] <span class="text-danger">*</span></label>
                        <input asp-for="ClassCode" class="form-control" placeholder="@L["VD: {0}", "IELTS-2401"]" autofocus />
                        <span asp-validation-for="ClassCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="ClassName" class="font-weight-bold">@L["Tên lớp học"] <span class="text-danger">*</span></label>
                        <input asp-for="ClassName" class="form-control" placeholder="@L["VD: IELTS Intensive Sáng 2-4-6"]" />
                        <span asp-validation-for="ClassName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="CourseId" class="font-weight-bold">@L["Khóa học đào tạo"] <span class="text-danger">*</span></label>
                        <select asp-for="CourseId" class="form-control" asp-items="ViewBag.CourseId">
                            <option value="">-- @L["Chọn khóa học"] --</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="LecturerName" class="font-weight-bold">@L["Giảng viên phụ trách"]</label>
                        <input asp-for="LecturerName" class="form-control" placeholder="@L["VD: Thầy John Smith"]" />
                        <span asp-validation-for="LecturerName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="Schedule" class="font-weight-bold">@L["Thời khóa biểu"] <span class="text-danger">*</span></label>
                        <input asp-for="Schedule" class="form-control" placeholder="@L["VD: Thứ 2 - 4 - 6 (18:00 - 20:00)"]" />
                        <span asp-validation-for="Schedule" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="Room" class="font-weight-bold">@L["Phòng học"]</label>
                        <input asp-for="Room" class="form-control" placeholder="@L["VD: Lab 202 (Cơ sở 1)"]" />
                        <span asp-validation-for="Room" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label asp-for="StartDate" class="font-weight-bold">@L["Ngày khai giảng"] <span class="text-danger">*</span></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="EndDate" class="font-weight-bold">@L["Ngày bế giảng (Dự kiến)"]</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="MaxCapacity" class="font-weight-bold">@L["Sĩ số tối đa"]</label>
                        <input asp-for="MaxCapacity" type="number" class="form-control" min="1" max="100" />
                        <span asp-validation-for="MaxCapacity" class="text-danger small"></span>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary shadow-sm">@L["Hủy bỏ"]</a>
                    <button type="submit" class="btn btn-primary shadow-sm">
                        <i class="fas fa-save mr-1"></i> @L["Lưu thông tin lớp"]
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
