    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Assignment.Models.Entities.Class

@{
    ViewData["Title"] = "Chỉnh sửa Lớp học";
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Cập nhật Lớp học</h1>
        <a asp-action="Index" class="btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50 mr-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow mb-4 p-0 border-left-warning">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-warning">Thông tin: @Model.ClassName (@Model.ClassCode)</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ClassId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="ClassCode" class="font-weight-bold">Mã lớp <span class="text-danger">*</span></label>
                        <input asp-for="ClassCode" class="form-control" />
                        <span asp-validation-for="ClassCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="ClassName" class="font-weight-bold">Tên lớp học <span class="text-danger">*</span></label>
                        <input asp-for="ClassName" class="form-control" />
                        <span asp-validation-for="ClassName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="CourseId" class="font-weight-bold">Khóa học <span class="text-danger">*</span></label>
                        <select asp-for="CourseId" class="form-control" asp-items="ViewBag.CourseId"></select>
                        <span asp-validation-for="CourseId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="LecturerName" class="font-weight-bold">Giảng viên phụ trách</label>
                        <input asp-for="LecturerName" class="form-control" />
                        <span asp-validation-for="LecturerName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="Schedule" class="font-weight-bold">Thời khóa biểu <span class="text-danger">*</span></label>
                        <input asp-for="Schedule" class="form-control" />
                        <span asp-validation-for="Schedule" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="Room" class="font-weight-bold">Phòng học</label>
                        <input asp-for="Room" class="form-control" />
                        <span asp-validation-for="Room" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label asp-for="StartDate" class="font-weight-bold">Ngày khai giảng <span class="text-danger">*</span></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="EndDate" class="font-weight-bold">Ngày bế giảng (Dự kiến)</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="MaxCapacity" class="font-weight-bold">Sĩ số tối đa</label>
                        <input asp-for="MaxCapacity" type="number" class="form-control" min="1" max="100" />
                        <span asp-validation-for="MaxCapacity" class="text-danger small"></span>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary shadow-sm">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning shadow-sm">
                        <i class="fas fa-check mr-1"></i> Cập nhật thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}