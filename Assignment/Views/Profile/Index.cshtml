@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@model Assignment.Models.Entities.Student

@{
    ViewData["Title"] = L["Hồ sơ cá nhân"];
}

<div class="container-fluid">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <form asp-action="Index" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- Giữ lại các Id quan trọng -->
        <input type="hidden" asp-for="StudentId" />
        <input type="hidden" asp-for="AvatarUrl" />

        <div class="row">
            <!-- CỘT 1 -->
            <div class="col-md-4 mb-4">
                <div class="card shadow text-center p-3 h-100">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">

                        <div class="mb-3">
                            <img id="avatarPreview"
                                 src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? Url.Content("~/img/undraw_profile_1.svg") : Url.Content(Model.AvatarUrl))"
                                 class="rounded-circle border shadow-sm"
                                 style="width: 140px; height: 140px; object-fit: cover;" alt="Avatar" />
                        </div>

                        <div class="custom-file text-left mb-3 w-100">
                            <input asp-for="AvatarFile" type="file" class="custom-file-input" id="customFile" accept="image/*">
                            <label class="custom-file-label text-truncate" for="customFile" data-browse="@L["Browse"]">
                                @L["Đổi ảnh..."]
                            </label>
                        </div>

                        <h5 class="font-weight-bold text-gray-800 mb-1">@Model.FullName</h5>
                        <p class="text-muted small mb-3">@L["Mã học viên"]: <strong>@Model.StudentCode</strong></p>

                        <div class="d-flex justify-content-center align-items-center">
                            <span class="btn btn-success btn-sm px-4 py-2 font-weight-bold" style="border-radius: 6px; cursor: default;">
                                <i class="fas fa-user-check mr-1"></i> @L["Học viên"]
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- CỘT 2 -->
            <div class="col-md-8 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-white font-weight-bold text-primary">
                        @L["Hồ sơ Học viên"]
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between">

                        <div>
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>@L["Mã học viên"]</label>
                                    <input asp-for="StudentCode" class="form-control bg-light" readonly />
                                </div>
                                <div class="form-group col-md-6">
                                    <label>@L["Họ và tên"]</label>
                                    <input asp-for="FullName" class="form-control bg-light" readonly />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>@L["Trình độ đầu vào"]</label>
                                    <input type="text" class="form-control bg-light" value="@(string.IsNullOrEmpty(Model.EntryLevel) ? "Beginner" : L[Model.EntryLevel])" readonly />
                                </div>
                                <div class="form-group col-md-6">
                                    <label>@L["Giới tính"]</label>
                                    <input type="text" class="form-control bg-light" value="@(Model.Gender == true ? L["Nam"] : L["Nữ"])" readonly />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>@L["Ngày sinh"]</label>
                                    <input type="text" class="form-control bg-light" value="@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? L["Chưa rõ"])" readonly />
                                </div>
                                <div class="form-group col-md-6">
                                    <label>@L["Số điện thoại"]</label>
                                    <input asp-for="PhoneNumber" class="form-control bg-light" readonly />
                                </div>
                            </div>

                            <div class="form-group">
                                <label>@L["Email"]</label>
                                <input asp-for="Email" class="form-control bg-light" readonly />
                            </div>

                            <div class="form-group">
                                <label>@L["Địa chỉ"]</label>
                                <input asp-for="Address" class="form-control bg-light" readonly />
                            </div>
                        </div>

                        <div class="text-right mt-3">
                            <button type="button" onclick="history.back()" class="btn btn-secondary mr-2">
                                @L["Quay lại"]
                            </button>
                            <button type="submit" class="btn btn-primary">
                                @L["Lưu thay đổi"]
                            </button>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('customFile').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                $(this).siblings(".custom-file-label").addClass("selected").html(file.name);
                const reader = new FileReader();
                reader.onload = function (event) {
                    document.getElementById('avatarPreview').src = event.target.result;
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}