@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@model Assignment.Models.Entities.Student

@{
    ViewData["Title"] = L["Hồ sơ cá nhân"];
    string roleName = ViewBag.RoleName?.ToString() ?? "Học viên";
    bool isStudent = roleName == "Học viên";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <form asp-action="Index" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StudentId" />
        <input type="hidden" asp-for="AvatarUrl" />

        <div class="row">
            <!-- CỘT BÊN TRÁI -->
            <div class="col-md-4 mb-4">
                <div class="card shadow text-center p-3 h-100">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <img id="avatarPreview"
                             src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? Url.Content("~/img/undraw_profile_1.svg") : Url.Content(Model.AvatarUrl))"
                             class="rounded-circle border shadow-sm mb-3" style="width: 140px; height: 140px; object-fit: cover;" />

                        @if (isStudent)
                        {
                            <div class="custom-file text-left mb-3 w-100">
                                <input asp-for="AvatarFile" type="file" class="custom-file-input" id="customFile" accept="image/*">
                                <label class="custom-file-label text-truncate" for="customFile">@L["Đổi ảnh..."]</label>
                            </div>
                        }

                        <h5 class="font-weight-bold text-gray-800 mb-1">@(isStudent ? Model.FullName : Model.StudentCode)</h5>
                        <p class="text-muted small mb-3">
                            @(isStudent ? L["Mã học viên"] : L["Tài khoản"]): <strong>@Model.StudentCode</strong>
                        </p>

                        <span class="btn @(isStudent ? "btn-success" : "btn-primary") btn-sm px-4 py-2 font-weight-bold">
                            <i class="fas @(isStudent ? "fa-user-check" : "fa-user-shield") mr-1"></i> @L[roleName]
                        </span>
                    </div>
                </div>
            </div>

            <!-- CỘT BÊN PHẢI -->
            <div class="col-md-8 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-white font-weight-bold text-primary">
                        @(isStudent ? L["Hồ sơ Học viên"] : $"{L["Hồ sơ"]}: {Model.StudentCode}")
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            @if (isStudent)
                            {
                                <div class="form-row">
                                    <div class="form-group col-md-6"><label>@L["Mã học viên"]</label><input asp-for="StudentCode" class="form-control bg-light" readonly /></div>
                                    <div class="form-group col-md-6"><label>@L["Họ và tên"]</label><input asp-for="FullName" class="form-control bg-light" readonly /></div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-6"><label>@L["Trình độ đầu vào"]</label><input type="text" class="form-control bg-light" value="@(string.IsNullOrEmpty(Model.EntryLevel) ? "Beginner" : L[Model.EntryLevel])" readonly /></div>
                                    <div class="form-group col-md-6"><label>@L["Giới tính"]</label><input type="text" class="form-control bg-light" value="@(Model.Gender == true ? L["Nam"] : L["Nữ"])" readonly /></div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-6"><label>@L["Ngày sinh"]</label><input type="text" class="form-control bg-light" value="@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? L["Chưa rõ"])" readonly /></div>
                                    <div class="form-group col-md-6"><label>@L["Số điện thoại"]</label><input asp-for="PhoneNumber" class="form-control bg-light" readonly /></div>
                                </div>
                                <div class="form-group"><label>@L["Email"]</label><input asp-for="Email" class="form-control bg-light" readonly /></div>
                                <div class="form-group"><label>@L["Địa chỉ"]</label><input asp-for="Address" class="form-control bg-light" readonly /></div>
                            }
                            else
                            {
                                <div class="form-group mb-3">
                                    <label>@L["Tên đăng nhập"]</label>
                                    <input asp-for="StudentCode" class="form-control bg-light" readonly />
                                </div>
                                <div class="form-group mb-3">
                                    <label>@L["Vai trò hệ thống"]</label>
                                    <input type="text" class="form-control bg-light" value="@L[roleName]" readonly />
                                </div>
                            }
                        </div>

                        <div class="text-right mt-3">
                            <button type="button" onclick="history.back()" class="btn btn-secondary">@L["Quay lại"]</button>
                            @if (isStudent)
                            {
                                <button type="submit" class="btn btn-primary ml-2">@L["Lưu thay đổi"]</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const customFile = document.getElementById('customFile');
        if (customFile) {
            customFile.addEventListener('change', function (e) {
                if (e.target.files[0]) {
                    $(this).siblings(".custom-file-label").addClass("selected").html(e.target.files[0].name);
                    const reader = new FileReader();
                    reader.onload = (evt) => document.getElementById('avatarPreview').src = evt.target.result;
                    reader.readAsDataURL(e.target.files[0]);
                }
            });
        }
    </script>
}